# Phase‑8 flags
OBLIVION_BUCKET_SIZE_USD=250     # adaptive position buckets
LP_ZERO_GUARD=true               # skip tokens with liq==0
SOCIAL_FEED_THROTTLE_MS=60000    # 1‑min cache to avoid API spam
JOHAN_PARANOIA_FUSE=true         # JohanShadow can freeze Conductor

# --- experimental flags (disabled by default) ---
ENABLE_GHOST_WALLET_STALKER=false      # watches & clones apex wallets
ENABLE_PRETRADE_SIMULATION=false       # simulateBundle sanity check
ENABLE_DIRECT_TPU_SENDER=false         # QUIC / TPU fast‑path
ENABLE_DYNAMIC_FEE_BIDDER=false        # priority‑fee auto‑tuner
ENABLE_BACKUP_WALLET_ROTATION=false    # rotates to fresh addresses
ENABLE_HONEYPOT_DETECTOR=false         # behavioural scam filter
ENABLE_SENTIMENT_ANOMALY_MONITOR=false # Twitter / TG divergence agent
ENABLE_TIME_OF_DAY_MODULATOR=false     # diurnal strategy weighting
ENABLE_LATENCY_PROFILER=false          # logs per‑step timings

# ───── Experimental Delta flags ─────
EXPERIMENTAL_THREAT_SCORE=false
EXPERIMENTAL_HELIUS_WEBHOOK=false
EXPERIMENTAL_LATENCY_PROFILER=false
EXPERIMENTAL_ASYNC_LEDGER=false
EXPERIMENTAL_LLM_SCHEDULER=false
FORBIDDEN_OPS=false

# ───── Phase‑9 Risk controls ─────
MAX_DD_PCT=15                 # portfolio max draw‑down
VAR_LOOKBACK_H=96             # hours for VaR window
KS_AUTO_UNFREEZE_MIN=0        # 0 = manual reset only

